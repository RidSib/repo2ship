# Agent engine: pi (default) or opencode. Per-role choices override AGENT_ENGINE.
AGENT_ENGINE=pi
# IMPLEMENTER_ENGINE=opencode
# STRATEGIST_ENGINE=pi

# OpenAI-compatible endpoint (default). Set models explicitly before a live run.
# Replace the URL/key with your provider's settings. No model is selected implicitly.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-your-api-key
IMPLEMENTER_MODEL=your-model-id
IMPLEMENTER_API=responses
# STRATEGIST_MODEL=your-review-model-id
# STRATEGIST_API=responses
# MODEL_PROVIDER=openai-compatible

# Alternative: Azure OpenAI / Microsoft Foundry.
# Replace the endpoint settings above; Azure hostnames are auto-detected.
# MODEL_PROVIDER=azure
# MODEL_BASE_URL=https://your-resource.openai.azure.com
# MODEL_API_KEY=replace-with-your-azure-key
# IMPLEMENTER_MODEL=your-deployment-name

# Alternative: Amazon Bedrock, through each engine's native provider.
# Endpoint URL/key and per-role API-format settings are unused for Bedrock.
# MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# IMPLEMENTER_MODEL=your-bedrock-model-or-inference-profile-id
# AWS_PROFILE=your-model-invocation-profile
# Or use a Bedrock API key instead of a profile:
# AWS_BEARER_TOKEN_BEDROCK=replace-with-your-bedrock-api-key
# See README for the optional GitHub Actions OIDC example. No AWS resources are provisioned.

# Optional Pi Chat Completions compatibility overrides, e.g. {"supportsReasoningEffort":true}.
# MODEL_COMPAT=
# Known model prices are estimates; generic overrides apply to all providers. USD per 1M tokens.
# MODEL_COST_INPUT_PER_1M=0
# MODEL_COST_OUTPUT_PER_1M=0
# MODEL_COST_CACHE_READ_PER_1M=0
# MODEL_COST_CACHE_WRITE_PER_1M=0

# Shared reasoning preference, translated where the selected engine/model supports it.
PI_THINKING_LEVEL=high
ENABLE_CRITIC=false

# Legacy OPENAI_* and AZURE_OPENAI_* endpoint/key/model settings, AZURE_MODEL_COMPAT,
# AZURE_CRITIC_MODEL, and AZURE_COST_*_PER_1M remain fallbacks. Generic settings win.

# Optional Langfuse tracing. Leave keys empty to disable upload.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
